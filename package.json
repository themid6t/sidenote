{
  "name": "sidenote",
  "version": "0.1.3",
  "description": "Read papers side by side with Claude: a CLI plus a local web reader",
  "type": "module",
  "bin": {
    "sidenote": "bin/sidenote.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "dompurify": "^3.5.0",
    "marked": "18.3.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
